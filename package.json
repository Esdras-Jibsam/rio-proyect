{
  "name": "rio-proyect-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "create-agent": "node --env-file-if-exists=.env scripts/create-agent.js",
    "setup-access": "node --env-file-if-exists=.env scripts/setup-access.js",
    "reset-access": "node --env-file-if-exists=.env scripts/setup-access.js --rotate",
    "test": "node --test"
  },
  "dependencies": {
    "@azure/ai-projects": "^2.10.0",
    "@azure/identity": "^4.14.1",
    "@napi-rs/canvas": "^1.1.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.3.0",
    "jose": "^6.1.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  }
}
